server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # BACKEND_URL llega desde compose.yml. Se resuelve en cada peticion para que nginx
        # arranque aunque el backend aun no este encendido.
        resolver 127.0.0.11 valid=10s;
        set $backend ${BACKEND_URL};
        proxy_pass $backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Igual que el proxy de Vite: sin Origin el backend no rechaza la peticion por CORS.
        proxy_set_header Origin "";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
